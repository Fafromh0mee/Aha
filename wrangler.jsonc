{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aha-live-classroom",
  "main": "./custom-worker.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "aha-live-classroom"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CLASSROOM_ROOM",
        "class_name": "ClassroomRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ClassroomRoom"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
